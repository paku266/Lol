        function renderChampionsGrid() {
            const container = document.getElementById('champions-grid');
            container.innerHTML = '';

            const sortedChamps = [...CHAMPIONS].sort((a, b) => a.name.localeCompare(b.name));

            sortedChamps.forEach(champ => {
                const card = document.createElement('div');
                card.id = `champ-card-${champ.key}`;
                card.className = `champ-card bg-black/60 border border-hex-border/60 rounded p-2 flex flex-col items-center justify-center text-center`;
                card.setAttribute('data-name', champ.name.toLowerCase());
                card.setAttribute('data-roles', champ.roles.join(',').toLowerCase());
                card.setAttribute('data-gender', champ.gender.toLowerCase());
                card.setAttribute('data-positions', (champ.positions || []).join(',').toLowerCase());
                card.setAttribute('data-champ-name', champ.name);

                const imgUrl = champ.icon || getChampImgUrl(champ.key);

                card.innerHTML = `
                    <img src="${imgUrl}" alt="${champ.name}" data-attempts="0" class="w-14 h-14 md:w-16 md:h-16 rounded-full border border-hex-border object-cover mb-1.5 pointer-events-none" onerror="handleImgError(this, '${champ.name}', '${champ.key}')">
                    <span class="font-cinzel text-xs font-bold text-hex-gold truncate w-full px-1 pointer-events-none">${champ.name}</span>
                `;

                // Single Click Handler
                card.onclick = () => toggleEliminate(champ.name, card);

                // Mouse Over / Hover Strike Handler
                card.onmouseenter = () => {
                    if (isHoverStrikeActive && !eliminatedChamps.has(champ.name)) {
                        toggleEliminate(champ.name, card, true);
                    }
                };

                container.appendChild(card);
            });

            updateCounters();
        }

        function toggleEliminate(champName, cardElement, forceEliminate = false, isBatch = false) {
            if (!isBatch) {
                saveStateToHistory();
            }

            if (forceEliminate) {
                eliminatedChamps.add(champName);
                cardElement.classList.add('eliminated');
            } else {
                if (eliminatedChamps.has(champName)) {
                    eliminatedChamps.delete(champName);
                    cardElement.classList.remove('eliminated');
                } else {
                    eliminatedChamps.add(champName);
                    cardElement.classList.add('eliminated');
                }
            }
            updateCounters();
        }

