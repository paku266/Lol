                    eliminatedChamps.add(champ.name);
                    const card = document.getElementById(`champ-card-${champ.key}`);
                    if (card) {
                        card.classList.add('eliminated');
                    }
                }
            });
            updateCounters();
        }

        function strikeByGender(genderName) {
            saveStateToHistory();
            CHAMPIONS.forEach(champ => {
                if (champ.gender === genderName) {
                    eliminatedChamps.add(champ.name);
                    const card = document.getElementById(`champ-card-${champ.key}`);
                    if (card) {
                        card.classList.add('eliminated');
                    }
                }
            });
            updateCounters();
        }

        function strikeByPosition(positionName) {
            saveStateToHistory();
            CHAMPIONS.forEach(champ => {
                if ((champ.positions || []).includes(positionName)) {
                    eliminatedChamps.add(champ.name);
                    const card = document.getElementById(`champ-card-${champ.key}`);
                    if (card) {
                        card.classList.add('eliminated');
                    }
                }
            });
            updateCounters();
        }

        function strikeVisibles() {
            saveStateToHistory();
            const cards = document.querySelectorAll('.champ-card:not(.hidden)');
            cards.forEach(card => {
                const champKey = card.id.replace('champ-card-', '');
                const champObj = CHAMPIONS.find(c => c.key === champKey);
                if (champObj) {
                    eliminatedChamps.add(champObj.name);
                    card.classList.add('eliminated');
                }
            });
            updateCounters();
        }

        function toggleKeepOnlyVisibles() {
            hideEliminated = !hideEliminated;
            const btn = document.getElementById('btn-keep-visibles');
            
            if (hideEliminated) {
                btn.classList.add('bg-cyan-800', 'border-cyan-400');
                btn.innerHTML = `<i class="fa-solid fa-eye text-cyan-300"></i> Mostrar Descartados`;
            } else {
                btn.classList.remove('bg-cyan-800', 'border-cyan-400');
                btn.innerHTML = `<i class="fa-solid fa-bullseye text-cyan-400"></i> Solo Conservar Visibles`;
            }
            filterChampions();
        }

        function filterChampions() {
            const searchVal = document.getElementById('search-input').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.champ-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const name = card.getAttribute('data-name');
                const roles = card.getAttribute('data-roles');
                const gender = card.getAttribute('data-gender');
                const positions = card.getAttribute('data-positions');
                const champName = card.getAttribute('data-champ-name');
                const isEliminated = eliminatedChamps.has(champName);

                const matchesSearch = name.includes(searchVal) || roles.includes(searchVal) || gender.includes(searchVal) || positions.includes(searchVal);

                if (matchesSearch && (!hideEliminated || !isEliminated)) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            document.getElementById('count-visible').textContent = visibleCount;
        }

        function resetGrid() {
            if (eliminatedChamps.size > 0) {
                saveStateToHistory();
            }
            eliminatedChamps.clear();
            hideEliminated = false;
            
            const btnKeep = document.getElementById('btn-keep-visibles');
            if (btnKeep) {
                btnKeep.classList.remove('bg-cyan-800', 'border-cyan-400');
                btnKeep.innerHTML = `<i class="fa-solid fa-bullseye text-cyan-400"></i> Solo Conservar Visibles`;
            }

            const cards = document.querySelectorAll('.champ-card');
            cards.forEach(card => card.classList.remove('eliminated'));
            document.getElementById('search-input').value = '';
            filterChampions();
            updateCounters();
        }

        function updateCounters() {
            const total = CHAMPIONS.length;
            const remaining = total - eliminatedChamps.size;
            document.getElementById('count-active').textContent = remaining;
            filterChampions();
        }

        async function loadChampionsData() {
            let data = DEFAULT_CHAMPIONS_DATA;
            try {
                const response = await fetch('./champions.json', { cache: 'no-store' });
                if (response.ok) {
                    const jsonData = await response.json();
                    if (Array.isArray(jsonData) && jsonData.length >= 2) {
                        data = jsonData;
                    }
                }
            } catch (e) {
                // Utiliza la lista DEFAULT_CHAMPIONS_DATA incrustada
            }

            CHAMPIONS = data.map(champ => ({
                ...champ,
                icon: getChampImgUrl(champ.key),
                roles: Array.isArray(champ.roles) ? champ.roles : [],
                positions: Array.isArray(champ.positions) ? champ.positions : [],
                gender: champ.gender || ''
            }));

            championsLoaded = true;
            renderChampionsGrid();
        }

        window.addEventListener('DOMContentLoaded', () => {
            setupDraggableChat();
            loadChampionsData();

            // Atajos de teclado para Deshacer (Ctrl + Z) y Rehacer (Ctrl + Y / Ctrl + Shift + Z)
            window.addEventListener('keydown', (e) => {
                if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
                    if (e.shiftKey) {
                        e.preventDefault();
                        redoAction();
                    } else {
                        e.preventDefault();
                        undoAction();
                    }
                } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'y') {
                    e.preventDefault();
                    redoAction();
                }
            });
        });
    </script>
</body>
</html>
