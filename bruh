
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adivina el Campeón de LoL - hola sander</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- PeerJS WebRTC Library for P2P Networking -->
    <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        hex: {
                            dark: '#010a13',
                            panel: '#091428',
                            card: '#0a192f',
                            border: '#785a28',
                            gold: '#c8aa6e',
                            goldHover: '#f0e6d2',
                            blue: '#0bc6ff',
                            red: '#e84057'
                        }
                    },
                    fontFamily: {
                        cinzel: ['Cinzel', 'serif'],
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #010a13;
            color: #f0e6d2;
            background-image: 
                radial-gradient(circle at 50% 0%, #0a1e3f 0%, transparent 80%),
                linear-gradient(to bottom, #010a13, #020d18);
            min-height: 100vh;
        }

        .hextech-box {
            background: rgba(9, 20, 40, 0.88);
            border: 2px solid #785a28;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.7), inset 0 0 15px rgba(200, 170, 110, 0.08);
            position: relative;
            backdrop-filter: blur(8px);
        }

        .hextech-btn {
            background: linear-gradient(180deg, #1e2328 0%, #091428 100%);
            border: 1px solid #c8aa6e;
            color: #f0e6d2;
            font-family: 'Cinzel', serif;
            font-weight: 700;
            letter-spacing: 1.2px;
            transition: all 0.2s ease-in-out;
            text-transform: uppercase;
        }

        .hextech-btn:hover:not(:disabled) {
            background: linear-gradient(180deg, #2a333c 0%, #112240 100%);
            border-color: #f0e6d2;
            box-shadow: 0 0 15px rgba(200, 170, 110, 0.4);
            transform: translateY(-1px);
            cursor: pointer;
        }

        .hextech-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            border-color: #555;
            box-shadow: none;
            transform: none;
        }

        .hextech-input {
            background: #010a13;
            border: 1px solid #785a28;
            color: #f0e6d2;
            transition: all 0.2s ease;
        }

        .hextech-input:focus {
            outline: none;
            border-color: #c8aa6e;
            box-shadow: 0 0 12px rgba(200, 170, 110, 0.3);
        }

        .champ-card {
            transition: transform 0.15s ease, border-color 0.15s ease, opacity 0.2s ease;
            cursor: pointer;
            user-select: none;
            position: relative;
            overflow: hidden;
        }

        .champ-card:hover {
            transform: translateY(-2px) scale(1.02);
            border-color: #c8aa6e;
            box-shadow: 0 4px 15px rgba(200, 170, 110, 0.25);
        }

        .champ-card.eliminated {
            opacity: 0.55;
            filter: grayscale(100%);
            border-color: #2a2a2a !important;
            transform: scale(0.95);
            box-shadow: none !important;
        }

        .champ-card.eliminated::after {
            content: '✕';
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: #e84057;
            font-weight: 900;
            background: rgba(0, 0, 0, 0.5);
            text-shadow: 0 0 8px rgba(0,0,0,0.9);
        }

        /* Hover strike mode indicator */
        .hover-active {
            background: rgba(200, 170, 110, 0.2) !important;
            border-color: #f0e6d2 !important;
            box-shadow: 0 0 12px rgba(200, 170, 110, 0.5) !important;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #010a13;
        }
        ::-webkit-scrollbar-thumb {
            background: #785a28;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #c8aa6e;
        }

        /* Draggable floating chat */
        #chat-window {
            position: fixed;
            right: 24px;
            bottom: 24px;
            width: min(360px, calc(100vw - 24px));
            z-index: 40;
            user-select: none;
        }
        #chat-window.chat-dragging {
            opacity: 0.92;
            cursor: grabbing;
        }
        #chat-header {
            cursor: grab;
        }
        #chat-header:active {
            cursor: grabbing;
        }
        #chat-messages {
            height: 220px;
            overflow-y: auto;
            user-select: text;
        }
        #chat-window.chat-collapsed {
            width: min(250px, calc(100vw - 24px));
        }
        #chat-collapse-btn {
            flex-shrink: 0;
        }
        @media (max-width: 640px) {
            #chat-window {
                right: 12px;
                bottom: 12px;
                width: calc(100vw - 24px);
            }
            #chat-messages {
                height: 180px;
            }
        }
    </style>
</head>
<body class="p-3 md:p-6 flex flex-col items-center">

    <header class="text-center mb-6 w-full max-w-6xl">
        <h1 class="font-cinzel text-3xl md:text-5xl font-extrabold text-hex-gold tracking-widest drop-shadow-md mb-1">
            ADIVINA EL <span class="text-hex-blue">CAMPEÓN</span> DE LOL
        </h1>
        <p class="text-xs md:text-sm text-hex-border tracking-widest font-semibold uppercase">
            Multijugador P2P en Tiempo Real • Todos los Campeones hasta Locke
        </p>
    </header>

    <section id="lobby-section" class="w-full max-w-2xl mb-8">
        <div class="hextech-box p-5 md:p-6 rounded-lg text-center">
            
            <!-- Connection Setup Controls -->
            <div id="connection-controls">
                <h2 class="font-cinzel text-xl text-hex-gold mb-4 font-bold">¿Cómo quieres jugar?</h2>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Host Room Card -->
                    <div class="p-4 bg-black/50 border border-hex-border rounded-lg flex flex-col justify-between">
                        <div>
                            <i class="fa-solid fa-crown text-3xl text-hex-gold mb-2"></i>
                            <h3 class="font-cinzel font-bold text-lg text-hex-gold">Crear Sala</h3>
                            <p class="text-xs text-gray-400 mt-1 mb-4">Crea una partida e invita a tu amigo dándole el código corto.</p>
                        </div>
                        <button onclick="createRoom()" id="btn-create" class="hextech-btn py-2.5 px-4 rounded text-sm w-full">
                            Generar Código
                        </button>
                    </div>

                    <!-- Join Room Card -->
                    <div class="p-4 bg-black/50 border border-hex-border rounded-lg flex flex-col justify-between">
                        <div>
                            <i class="fa-solid fa-users text-3xl text-hex-blue mb-2"></i>
                            <h3 class="font-cinzel font-bold text-lg text-hex-gold">Unirse a Sala</h3>
                            <p class="text-xs text-gray-400 mt-1 mb-3">Introduce el código corto que te ha dado tu amigo.</p>
                        </div>
                        <div class="flex space-x-2">
                            <input type="text" id="join-code-input" placeholder="Ej: LOL-7723" class="hextech-input px-3 py-2 rounded text-center text-sm font-bold uppercase w-full" maxlength="8">
                            <button onclick="joinRoom()" id="btn-join" class="hextech-btn px-4 py-2 rounded text-sm">
                                Entrar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Active Room Info Bar -->
            <div id="room-active-bar" class="hidden flex flex-col sm:flex-row items-center justify-between bg-black/70 p-4 border border-hex-gold rounded-lg">
                <div class="flex items-center space-x-3 mb-3 sm:mb-0">
                    <span class="text-xs text-hex-border font-bold uppercase tracking-wider">Código de Sala:</span>
                    <span id="room-code-display" class="font-mono text-2xl font-extrabold text-hex-gold bg-hex-dark px-3 py-1 border border-hex-border rounded tracking-widest">LOL-----</span>
                    <button onclick="copyRoomCode()" class="text-xs bg-hex-border/30 hover:bg-hex-border/60 text-hex-gold px-2.5 py-2 rounded transition" title="Copiar código de sala">
                        <i class="fa-regular fa-copy"></i>
                    </button>
                </div>
                
                <div class="flex items-center space-x-4">
                    <div id="status-badge" class="flex items-center space-x-2 px-3 py-1.5 rounded bg-yellow-900/40 border border-yellow-600/50 text-xs text-yellow-300">
                        <span class="w-2.5 h-2.5 rounded-full bg-yellow-400 animate-ping"></span>
                        <span id="status-text">Esperando al rival...</span>
                    </div>
                    
                    <button onclick="disconnect()" class="text-xs text-red-400 hover:text-red-300 border border-red-500/30 px-3 py-1.5 rounded bg-red-900/20 hover:bg-red-900/40 transition">
                        Salir
                    </button>
                </div>
            </div>

        </div>
    </section>

    <section id="game-section" class="w-full max-w-6xl mb-8 opacity-40 pointer-events-none transition-all duration-300">
        
        <!-- Controls & Sync Button -->
        <div class="flex flex-col sm:flex-row items-center justify-between mb-6 bg-hex-panel border border-hex-border p-4 rounded-lg shadow-lg">
            <div class="mb-3 sm:mb-0 text-center sm:text-left">
                <h3 class="font-cinzel text-lg text-hex-gold font-bold">Panel de Partida</h3>
                <p class="text-xs text-gray-400">El Host pulsa el botón para asignar un campeón secreto aleatorio a cada jugador.</p>
            </div>
            
            <button onclick="rollChampions()" id="btn-roll" disabled class="hextech-btn py-3 px-6 rounded text-sm md:text-base flex items-center space-x-2 shadow-lg">
                <i class="fa-solid fa-dice text-xl text-hex-gold"></i>
                <span id="btn-roll-text">Generar Campeones Aleatorios</span>
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- My Secret Champion Card -->
            <div class="hextech-box p-6 rounded-lg flex flex-col items-center text-center">
                <span class="text-xs font-bold text-hex-blue tracking-widest uppercase mb-1">Tu Campeón Asignado</span>
                <p class="text-xs text-gray-400 mb-4">(Este es el campeón que tu amigo debe adivinar)</p>
                
                <div class="w-full min-h-[180px] bg-black/60 border border-hex-border rounded-lg p-4 flex flex-col items-center justify-center relative">
                    
                    <div id="my-champ-content" class="hidden flex-col items-center">
                        <div id="my-champ-secret" class="filter blur-md transition-all duration-300 pointer-events-none select-none flex flex-col items-center">
                            <img id="my-champ-img" src="" alt="Tu Campeón" class="w-24 h-24 rounded-full border-2 border-hex-gold object-cover mb-3 shadow-lg">
                            <h2 id="my-champ-name" class="font-cinzel text-2xl font-extrabold text-hex-gold tracking-wider mb-1">---</h2>
                        </div>

                        <button onclick="toggleSecretView()" id="btn-reveal" class="mt-4 text-xs bg-hex-dark border border-hex-gold/60 text-hex-gold hover:text-white px-4 py-2 rounded flex items-center space-x-2 transition z-10">
                            <i id="reveal-icon" class="fa-solid fa-eye"></i>
                            <span id="reveal-text">Mostrar Campeón</span>
                        </button>
                    </div>

                    <div id="my-champ-placeholder" class="text-gray-500 flex flex-col items-center">
                        <i class="fa-solid fa-question text-4xl mb-2 text-hex-border"></i>
                        <span class="text-xs uppercase tracking-wider font-semibold">Esperando asignación...</span>
                    </div>

                </div>
            </div>

            <!-- Enemy Champion Target Card -->
            <div class="hextech-box p-6 rounded-lg flex flex-col items-center text-center">
                <span class="text-xs font-bold text-hex-red tracking-widest uppercase mb-1">Campeón de tu Amigo</span>
                <p class="text-xs text-gray-400 mb-4">(El campeón que tú debes adivinar)</p>
                
                <div class="w-full min-h-[180px] bg-black/60 border border-red-900/40 rounded-lg p-4 flex flex-col items-center justify-center">
                    <div class="w-20 h-20 rounded-full border-2 border-red-900/60 bg-red-950/30 flex items-center justify-center mb-3">
                        <i class="fa-solid fa-user-ninja text-3xl text-red-500/70"></i>
                    </div>
                    <h3 class="font-cinzel text-xl font-bold text-red-400/90 uppercase tracking-wider">Oculto</h3>
                    <p class="text-xs text-gray-400 mt-2 max-w-xs">Haz preguntas de SÍ/NO por chat o llamada e ve tachando opciones en el tablero de abajo.</p>
                </div>
            </div>

        </div>
    </section>

    <section class="w-full max-w-6xl">
        <div class="hextech-box p-5 md:p-6 rounded-lg">
            
            <!-- Header Row with Title, Search, Undo/Redo, Hover Mode, Reset -->
            <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4 mb-5">
                <div>
                    <h2 class="font-cinzel text-2xl md:text-3xl text-hex-gold font-bold tracking-wider mb-1 uppercase">
                        TABLERO DE DESCARTE RÁPIDO
                    </h2>
                    <p class="text-xs md:text-sm text-gray-300">
                        Haz clic individualmente o usa las <strong class="text-hex-gold">Acciones Rápidas</strong> para descartar grupos enteros de un solo clic.
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-2.5">
                    <!-- Search Input -->
                    <div class="relative">
                        <input type="text" id="search-input" oninput="filterChampions()" placeholder="Buscar por nombre, rol, género o posición..." class="hextech-input text-xs px-3 py-2 pl-8 rounded w-48 sm:w-60 bg-black/60 border border-hex-border text-hex-gold placeholder-gray-500 focus:outline-none focus:border-hex-gold">
                        <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-2.5 text-xs text-hex-border"></i>
                    </div>

                    <!-- Undo Button -->
                    <button id="btn-undo" onclick="undoAction()" disabled class="text-xs border border-hex-border hover:border-hex-gold disabled:opacity-40 disabled:cursor-not-allowed px-3 py-2 rounded bg-hex-dark text-hex-gold font-semibold transition flex items-center gap-1.5 shadow-sm" title="Deshacer el último descarte (Ctrl + Z)">
                        <i class="fa-solid fa-rotate-left"></i> Deshacer
                    </button>

                    <!-- Redo Button -->
                    <button id="btn-redo" onclick="redoAction()" disabled class="text-xs border border-hex-border hover:border-hex-gold disabled:opacity-40 disabled:cursor-not-allowed px-3 py-2 rounded bg-hex-dark text-hex-gold font-semibold transition flex items-center gap-1.5 shadow-sm" title="Rehacer el descarte (Ctrl + Y)">
                        <i class="fa-solid fa-rotate-right"></i> Rehacer
                    </button>

                    <!-- Mode Toggle Button -->
                    <button id="hover-mode-btn" onclick="toggleHoverStrikeMode()" class="text-xs border border-hex-border hover:border-hex-gold px-3 py-2 rounded bg-hex-dark text-hex-gold font-semibold transition flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-hand-pointer text-hex-gold"></i>
                        <span id="hover-mode-text">Modo Tachar Desactivado</span>
                    </button>

                    <!-- Reset Grid Button -->
                    <button onclick="resetGrid()" class="text-xs border border-hex-border hover:border-hex-gold px-3 py-2 rounded bg-hex-dark text-hex-gold font-semibold transition flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-arrow-rotate-right"></i> Reiniciar Tablero
                    </button>
                </div>
            </div>

            <!-- Quick Strike Action Bar (Roles, Gender & Visibles) -->
            <div class="bg-black/50 border border-hex-border/60 rounded-lg p-3 md:p-4 mb-5">
                <div class="flex flex-col gap-3">
                    
                    <!-- Role strike buttons -->
                    <div class="flex flex-wrap items-center gap-2 w-full">
                        <span class="text-xs font-bold text-hex-gold uppercase tracking-wider flex items-center gap-1.5 mr-1 whitespace-nowrap">
                            <i class="fa-solid fa-filter text-hex-gold"></i> TACHAR ROL:
                        </span>

                        <button onclick="strikeByRole('Asesinos')" class="text-xs px-3 py-1.5 rounded border border-hex-border/80 bg-hex-dark hover:bg-hex-border/30 hover:border-hex-gold text-hex-gold font-medium transition flex items-center gap-1.5 shadow-sm">
                            <span>⚔️</span> Asesinos
                        </button>
                        <button onclick="strikeByRole('Luchadores')" class="text-xs px-3 py-1.5 rounded border border-hex-border/80 bg-hex-dark hover:bg-hex-border/30 hover:border-hex-gold text-hex-gold font-medium transition flex items-center gap-1.5 shadow-sm">
                            <span>🛡️</span> Luchadores
                        </button>
                        <button onclick="strikeByRole('Magos')" class="text-xs px-3 py-1.5 rounded border border-hex-border/80 bg-hex-dark hover:bg-hex-border/30 hover:border-hex-gold text-hex-gold font-medium transition flex items-center gap-1.5 shadow-sm">
                            <span>🔮</span> Magos
                        </button>
                        <button onclick="strikeByRole('Tiradores')" class="text-xs px-3 py-1.5 rounded border border-hex-border/80 bg-hex-dark hover:bg-hex-border/30 hover:border-hex-gold text-hex-gold font-medium transition flex items-center gap-1.5 shadow-sm">
                            <span>🏹</span> Tiradores
                        </button>
                        <button onclick="strikeByRole('Tanques')" class="text-xs px-3 py-1.5 rounded border border-hex-border/80 bg-hex-dark hover:bg-hex-border/30 hover:border-hex-gold text-hex-gold font-medium transition flex items-center gap-1.5 shadow-sm">
                            <span>🏰</span> Tanques
                        </button>
                        <button onclick="strikeByRole('Soportes')" class="text-xs px-3 py-1.5 rounded border border-hex-border/80 bg-hex-dark hover:bg-hex-border/30 hover:border-hex-gold text-hex-gold font-medium transition flex items-center gap-1.5 shadow-sm">
                            <span>💚</span> Soportes
                        </button>
                    </div>

                    <!-- Position strike buttons -->
                    <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-hex-border/30">
                        <span class="text-xs font-bold text-hex-gold uppercase tracking-wider flex items-center gap-1.5 mr-1 whitespace-nowrap">
                            <i class="fa-solid fa-map-location-dot text-hex-gold"></i> TACHAR POSICIÓN:
                        </span>

                        <button onclick="strikeByPosition('Top')" class="text-xs px-3 py-1.5 rounded border border-hex-border/80 bg-hex-dark hover:bg-hex-border/30 hover:border-hex-gold text-hex-gold font-medium transition flex items-center gap-1.5 shadow-sm">Top</button>
                        <button onclick="strikeByPosition('Jungle')" class="text-xs px-3 py-1.5 rounded border border-hex-border/80 bg-hex-dark hover:bg-hex-border/30 hover:border-hex-gold text-hex-gold font-medium transition flex items-center gap-1.5 shadow-sm">Jungle</button>
                        <button onclick="strikeByPosition('Mid')" class="text-xs px-3 py-1.5 rounded border border-hex-border/80 bg-hex-dark hover:bg-hex-border/30 hover:border-hex-gold text-hex-gold font-medium transition flex items-center gap-1.5 shadow-sm">Mid</button>
                        <button onclick="strikeByPosition('Bot')" class="text-xs px-3 py-1.5 rounded border border-hex-border/80 bg-hex-dark hover:bg-hex-border/30 hover:border-hex-gold text-hex-gold font-medium transition flex items-center gap-1.5 shadow-sm">Bot</button>
                        <button onclick="strikeByPosition('Support')" class="text-xs px-3 py-1.5 rounded border border-hex-border/80 bg-hex-dark hover:bg-hex-border/30 hover:border-hex-gold text-hex-gold font-medium transition flex items-center gap-1.5 shadow-sm">Support</button>
                    </div>

                    <!-- Gender strike & visibility action buttons -->
                    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 pt-2 border-t border-hex-border/30">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-xs font-bold text-hex-gold uppercase tracking-wider flex items-center gap-1.5 mr-1 whitespace-nowrap">
                                <i class="fa-solid fa-venus-mars text-hex-gold"></i> TACHAR GÉNERO:
                            </span>

                            <button onclick="strikeByGender('Masculino')" class="text-xs px-3 py-1.5 rounded border border-hex-border/80 bg-hex-dark hover:bg-hex-border/30 hover:border-hex-gold text-hex-gold font-medium transition flex items-center gap-1.5 shadow-sm">
                                <span>♂️</span> Masculino
                            </button>
                            <button onclick="strikeByGender('Femenino')" class="text-xs px-3 py-1.5 rounded border border-hex-border/80 bg-hex-dark hover:bg-hex-border/30 hover:border-hex-gold text-hex-gold font-medium transition flex items-center gap-1.5 shadow-sm">
                                <span>♀️</span> Femenino
                            </button>
                        </div>

                        <!-- Visibility action buttons -->
                        <div class="flex items-center gap-2.5 justify-end">
                            <!-- Strike Visibles -->
                            <button onclick="strikeVisibles()" class="text-xs px-3.5 py-1.5 rounded border border-red-800/80 bg-red-950/80 hover:bg-red-900/90 text-red-200 font-bold transition flex items-center gap-1.5 shadow">
                                <i class="fa-solid fa-bolt text-red-400"></i> Tachar Visibles
                            </button>

                            <!-- Toggle Hide/Show Discarded -->
                            <button id="btn-keep-visibles" onclick="toggleKeepOnlyVisibles()" class="text-xs px-3.5 py-1.5 rounded border border-cyan-700/80 bg-cyan-950/80 hover:bg-cyan-900/90 text-cyan-200 font-bold transition flex items-center gap-1.5 shadow">
                                <i class="fa-solid fa-bullseye text-cyan-400"></i> Solo Conservar Visibles
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            <div class="pt-2 border-t border-hex-border/40 flex justify-between items-center text-xs font-semibold px-1 text-gray-300 mb-4">
                <div>
                    Mostrando: <strong id="count-visible" class="text-hex-gold font-bold">0</strong> campeones
                </div>
                <div>
                    Restantes sin tachar: <strong id="count-active" class="text-hex-blue font-bold">0</strong>
                </div>
            </div>

            <!-- Champions Grid Container -->
            <div id="champions-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 max-h-[620px] overflow-y-auto pr-1">
                <!-- Dynamically populated via JavaScript -->
            </div>

        </div>
    </section>

    <!-- Draggable Chat -->
    <aside id="chat-window" class="hextech-box rounded-lg overflow-hidden shadow-2xl">
        <div id="chat-header" class="flex items-center justify-between px-3 py-2 bg-black/70 border-b border-hex-border">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-comments text-hex-blue"></i>
                <span class="font-cinzel text-sm font-bold text-hex-gold truncate">CHAT DE LA SALA</span>
                <span id="chat-unread-badge" class="hidden min-w-5 h-5 px-1.5 rounded-full bg-hex-red text-white text-[10px] font-bold flex items-center justify-center">0</span>
            </div>
            <div class="flex items-center gap-1">
                <button id="chat-collapse-btn" onclick="toggleChatCollapse()" type="button"
