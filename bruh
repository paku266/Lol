            if (btnRedo) btnRedo.disabled = (redoStack.length === 0);
        }

        function undoAction() {
            if (undoStack.length === 0) return;
            redoStack.push(new Set(eliminatedChamps));
            const previousState = undoStack.pop();
            eliminatedChamps = previousState;
            applyEliminatedStateToGrid();
            updateUndoRedoButtons();
        }

        function redoAction() {
            if (redoStack.length === 0) return;
            undoStack.push(new Set(eliminatedChamps));
            const nextState = redoStack.pop();
            eliminatedChamps = nextState;
            applyEliminatedStateToGrid();
            updateUndoRedoButtons();
        }

