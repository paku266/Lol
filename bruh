            return `https://cdn.communitydragon.org/latest/champion/${key}/square`;
        }

        function handleImgError(imgElement, champName, champKey) {
            const key = champKey || champName;
            const attempts = parseInt(imgElement.getAttribute('data-attempts') || '0', 10);

            if (key === 'Locke' || champName === 'Locke') {
                if (attempts === 0) {
                    imgElement.setAttribute('data-attempts', '1');
                    imgElement.src = 'locke.png';
                    return;
                }
            }
            if (key === 'Zaahen' || champName === 'Zaahen') {
                if (attempts === 0) {
                    imgElement.setAttribute('data-attempts', '1');
                    imgElement.src = 'zaahen.png';
                    return;
                }
            }

            const fallbacks = [
                `https://ddragon.leagueoflegends.com/cdn/15.4.1/img/champion/${key}.png`,
                `https://ddragon.leagueoflegends.com/cdn/14.24.1/img/champion/${key}.png`,
                `https://cdn.communitydragon.org/latest/champion/${key.toLowerCase()}/square`
            ];

            if (attempts < fallbacks.length) {
                imgElement.setAttribute('data-attempts', (attempts + 1).toString());
                imgElement.src = fallbacks[attempts];
                return;
            }

            imgElement.onerror = null;
            const initials = champName.substring(0, 2).toUpperCase();
            const svg = `
                <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100">
                    <rect width="100" height="100" fill="#091428"/>
                    <circle cx="50" cy="50" r="42" fill="none" stroke="#785a28" stroke-width="3"/>
                    <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" fill="#c8aa6e" font-family="Georgia, serif" font-size="32" font-weight="bold">${initials}</text>
