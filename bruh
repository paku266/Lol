        function sendChatMessage() {
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (!text) return;

            if (!conn || !conn.open) {
                addChatMessage('Sistema', 'Debes estar conectado a una sala con tu amigo para chatear.', 'system');
                input.value = '';
                return;
            }

            addChatMessage('Tú', text, 'self');
            conn.send({ type: 'CHAT_MESSAGE', text: text });
            input.value = '';
            input.focus();
        }

        function addChatMessage(sender, text, type) {
            const container = document.getElementById('chat-messages');
            const msgEl = document.createElement('div');
            msgEl.className = 'text-xs drop-shadow-sm font-sans break-words';
            const safeText = escapeHtml(String(text));

            if (type === 'system') {
                msgEl.innerHTML = `<span class="text-yellow-400 font-bold">[Sistema]:</span> <span class="text-yellow-200">${safeText}</span>`;
            } else if (type === 'self') {
                msgEl.innerHTML = `<span class="text-hex-blue font-bold">[Tú]:</span> <span class="text-gray-200">${safeText}</span>`;
            } else {
                msgEl.innerHTML = `<span class="text-hex-gold font-bold">[Amigo]:</span> <span class="text-gray-200">${safeText}</span>`;
            }

            container.appendChild(msgEl);
            container.scrollTop = container.scrollHeight;

            if (isChatCollapsed && type !== 'self') {
                unreadChatMessages++;
                const badge = document.getElementById('chat-unread-badge');
                badge.textContent = unreadChatMessages;
                badge.classList.remove('hidden');
            }
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function clampChatPosition(left, top) {
            const chat = document.getElementById('chat-window');
            const margin = 8;
            const maxLeft = Math.max(margin, window.innerWidth - chat.offsetWidth - margin);
            const maxTop = Math.max(margin, window.innerHeight - chat.offsetHeight - margin);
            return {
                left: Math.min(Math.max(left, margin), maxLeft),
                top: Math.min(Math.max(top, margin), maxTop)
            };
        }

        function setChatPosition(left, top, save = true) {
            const chat = document.getElementById('chat-window');
            const pos = clampChatPosition(left, top);
            chat.style.left = `${pos.left}px`;
            chat.style.top = `${pos.top}px`;
            chat.style.right = 'auto';
            chat.style.bottom = 'auto';
            if (save) localStorage.setItem(CHAT_POSITION_KEY, JSON.stringify(pos));
        }

        function restoreChatPosition() {
            const chat = document.getElementById('chat-window');
            const saved = localStorage.getItem(CHAT_POSITION_KEY);

            if (saved) {
                try {
                    const pos = JSON.parse(saved);
                    if (Number.isFinite(pos.left) && Number.isFinite(pos.top)) {
                        requestAnimationFrame(() => setChatPosition(pos.left, pos.top, false));
                        return;
                    }
                } catch (_) {}
            }

            requestAnimationFrame(() => {
                const rect = chat.getBoundingClientRect();
                setChatPosition(window.innerWidth - rect.width - 24, window.innerHeight - rect.height - 24, false);
            });
        }

        function startChatDrag(event) {
            if (event.target.closest('button') || event.target.closest('input')) return;
            const chat = document.getElementById('chat-window');
            const rect = chat.getBoundingClientRect();
            chatDragState = {
                offsetX: event.clientX - rect.left,
                offsetY: event.clientY - rect.top
            };
            chat.setPointerCapture?.(event.pointerId);
            chat.classList.add('chat-dragging');
            event.preventDefault();
        }

        function moveChat(event) {
            if (!chatDragState) return;
            setChatPosition(event.clientX - chatDragState.offsetX, event.clientY - chatDragState.offsetY, false);
        }

        function stopChatDrag() {
            if (!chatDragState) return;
            chatDragState = null;
            document.getElementById('chat-window').classList.remove('chat-dragging');
            const chat = document.getElementById('chat-window');
            localStorage.setItem(CHAT_POSITION_KEY, JSON.stringify({
                left: parseFloat(chat.style.left),
                top: parseFloat(chat.style.top)
            }));
        }

        function setupDraggableChat() {
            const header = document.getElementById('chat-header');
            header.addEventListener('pointerdown', startChatDrag);
            window.addEventListener('pointermove', moveChat);
            window.addEventListener('pointerup', stopChatDrag);
            window.addEventListener('resize', () => {
                const chat = document.getElementById('chat-window');
                const rect = chat.getBoundingClientRect();
                setChatPosition(rect.left, rect.top, true);
            });
            restoreChatPosition();
        }

        function createRoom() {
            const btn = document.getElementById('btn-create');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Generando...';

            cleanRoomCode = 'LOL-' + Math.floor(1000 + Math.random() * 9000);
            const internalPeerId = PEER_PREFIX + cleanRoomCode;

            peer = new Peer(internalPeerId, {
                config: { iceServers: STUN_SERVERS }
            });

            peer.on('open', () => {
                isHost = true;
                showRoomActiveUI(cleanRoomCode);
                updateConnectionStatus("waiting", "Esperando a tu amigo...");
            });

            peer.on('connection', (incomingConn) => {
                conn = incomingConn;
                setupConnectionListeners();
            });

            peer.on('error', (err) => {
                console.error("PeerJS Host Error:", err);
                btn.disabled = false;
                btn.innerHTML = 'Generar Código';
                
                if (err.type === 'unavailable-id') {
                    createRoom();
                } else {
                    showModal("Error de Conexión", "No se pudo iniciar el servidor P2P. Inténtalo de nuevo.", "fa-triangle-exclamation text-red-500");
                }
            });
        }

        function joinRoom() {
            let codeInput = document.getElementById('join-code-input').value.trim().toUpperCase();
            if (!codeInput) {
                return showModal("Código Requerido", "Por favor introduce el código de sala (ejemplo: LOL-7723).", "fa-circle-exclamation text-hex-gold");
            }

            if (!codeInput.startsWith("LOL-")) {
                codeInput = "LOL-" + codeInput.replace(/[^0-9]/g, '');
            }

            cleanRoomCode = codeInput;
            const internalPeerId = PEER_PREFIX + cleanRoomCode;

            const btn = document.getElementById('btn-join');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

            peer = new Peer(null, {
                config: { iceServers: STUN_SERVERS }
            });

            peer.on('open', () => {
                isHost = false;
                conn = peer.connect(internalPeerId, { reliable: true });
                setupConnectionListeners();
            });

            peer.on('error', (err) => {
                console.error("PeerJS Client Error:", err);
                btn.disabled = false;
                btn.innerHTML = 'Entrar';
                showModal("Error al Unirse", "No se encontró la sala " + cleanRoomCode + ". Verifica que el código sea correcto.", "fa-circle-xmark text-red-500");
            });
        }

