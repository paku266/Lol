                }
            });

            conn.on('data', (data) => {
                handleIncomingData(data);
            });

            conn.on('close', () => {
                updateConnectionStatus("disconnected", "Amigo desconectado");
                showModal("Conexión Perdida", "Tu amigo se ha desconectado de la sala.", "fa-circle-exclamation text-yellow-500");
